<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The .NET programs inside the Mac app (the server, Contents/Resources/Server/OneThing.Web, and the command line,
  cli/onething) under the hardened runtime: .NET compiles code as it runs (JIT) and a self-contained single-file
  program loads native libraries it carries or unpacks, which aren't signed by the app's team. build/mac-notarize.sh
  signs them with these.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
