<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reaching a connected computer (its HTTPS phone port, on Wi-Fi or Tailscale). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reminders, and when a focus session or a break ends with the app closed (asked for at the first snooze or focus). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- On time to the minute when the phone allows it (else the alarm may come a little late). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- To set the reminders and the focus timer's alarms again after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.TodoTracker">
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- todotracker://task/<id> links open the task (TaskLinks); todotracker://pair?… connects to a computer (PhoneLink). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="todotracker" />
            </intent-filter>
        </activity>
        <!-- Scanning a computer's pairing code (Settings › Connect to a computer), upright or sideways. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />
        <receiver android:name=".app.FocusAlarmReceiver" android:exported="false" />
        <!-- A reminder is due (or a snooze ends), and Mark done / In an hour on its notification. -->
        <receiver android:name=".app.ReminderAlarmReceiver" android:exported="false" />
        <receiver android:name=".app.ReminderActionReceiver" android:exported="false" />
        <!-- The phone forgets alarms when it restarts (or the app is updated): they're set again. -->
        <receiver android:name=".app.RestartReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
