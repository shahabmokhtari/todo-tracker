<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same rules for cloud backups and for moving to a new phone (see backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sync.xml" />
        <exclude domain="file" path="sync/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sync.xml" />
        <exclude domain="file" path="sync/" />
    </device-transfer>
</data-extraction-rules>
