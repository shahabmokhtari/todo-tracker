// Todo Tracker website: a static site served by Cloudflare Workers static assets.
// No account id or credentials here: wrangler reads them from your environment (see README.md).
{
  "name": "todotracker-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "todotracker.awesomehq.app", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
