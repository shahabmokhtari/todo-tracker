<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon); WPF types stay the default names. -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TodoTracker</AssemblyName>
    <RootNamespace>TodoTracker.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: Fluent ThemeMode is marked experimental but is the supported way to get Windows 11 styling + dark mode. -->
    <!-- WFO0003: a WinForms-app rule; this is a WPF app whose per-monitor DPI awareness belongs in app.manifest. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <ProjectReference Include="..\TodoTracker.Server\TodoTracker.Server.csproj" />
    <ProjectReference Include="..\TodoTracker.Desktop\TodoTracker.Desktop.csproj" />
    <!-- Ships tt.exe next to the app, so AI apps can launch "tt mcp" without installing anything else. -->
    <ProjectReference Include="..\TodoTracker.Cli\TodoTracker.Cli.csproj" />
  </ItemGroup>
</Project>

