<Window x:Class="TodoTracker.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:TodoTracker.Desktop;assembly=TodoTracker.Desktop"
        Title="Todo Tracker"
        Width="360" Height="800"
        MinWidth="56"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        AutomationProperties.Name="Todo Tracker sidebar">
    <Window.Resources>
        <!-- One task card. Commands bind to the window's view model; the card is the parameter. -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type d:CardViewModel}">
            <Border x:Name="CardBorder" Margin="0,0,0,6" Padding="0,6,6,6" CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding PriorityColor, Converter={StaticResource HexBrush}}" CornerRadius="2" ToolTip="{Binding PriorityLabel}" />
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Breadcrumb}" Style="{StaticResource Muted}" Visibility="{Binding Breadcrumb, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Muted}" Visibility="{Binding Meta, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding ReminderMessage, StringFormat=⏰ {0}}" Foreground="{StaticResource Attention}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Visibility="{Binding NeedsAttention, Converter={StaticResource VisibleWhen}}" />
                        <WrapPanel Margin="0,4,0,0">
                            <Button Style="{StaticResource IconButton}" Content="✓" ToolTip="Done" AutomationProperties.Name="Done"
                                    Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    Visibility="{Binding CanComplete, Converter={StaticResource VisibleWhen}}" />
                            <Button Style="{StaticResource IconButton}" Content="🔕" ToolTip="Dismiss reminder" AutomationProperties.Name="Dismiss reminder"
                                    Command="{Binding DataContext.DismissReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    Visibility="{Binding NeedsAttention, Converter={StaticResource VisibleWhen}}" />
                            <Button Style="{StaticResource IconButton}" Content="↩" ToolTip="Bring back to Do now" AutomationProperties.Name="Bring back"
                                    Command="{Binding DataContext.BringBackCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    Visibility="{Binding IsWaiting, Converter={StaticResource VisibleWhen}}" />
                            <Button Style="{StaticResource IconButton}" Content="⏰" ToolTip="Snooze (remind me later)" AutomationProperties.Name="Snooze" Click="OnSnoozeClick" />
                            <Button Style="{StaticResource IconButton}" Content="✎" ToolTip="Add note" AutomationProperties.Name="Add note"
                                    Command="{Binding DataContext.ToggleNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource IconButton}" Content="▶" ToolTip="Start focus timer on this" AutomationProperties.Name="Focus"
                                    Command="{Binding DataContext.StartFocusCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource IconButton}" Content="⋯" ToolTip="More" AutomationProperties.Name="More" Click="OnMoreClick" />
                        </WrapPanel>
                        <Grid Margin="0,4,0,0" Visibility="{Binding IsNoteOpen, Converter={StaticResource VisibleWhen}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NoteDraft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False" TextWrapping="Wrap" MaxLength="10000"
                                     AutomationProperties.Name="Note" KeyDown="OnNoteKeyDown" />
                            <Button Grid.Column="1" Content="Save" Margin="4,0,0,0"
                                    Command="{Binding DataContext.AddNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                    <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource AttentionSoft}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Full sidebar -->
        <Grid x:Name="FullView" Margin="10,8,10,8"
              Visibility="{Binding IsCompact, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="✓ Todo Tracker" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="⋯" ToolTip="Menu" AutomationProperties.Name="Menu" Click="OnMenuClick" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="🌐" ToolTip="Open dashboard &amp; full report in browser" AutomationProperties.Name="Open dashboard" Command="{Binding OpenDashboardCommand}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="⇥" ToolTip="Collapse to a thin strip" AutomationProperties.Name="Collapse" Command="{Binding ToggleCompactCommand}" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type d:GroupTabViewModel}">
                                <ToggleButton Margin="0,0,4,0" Padding="10,2" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                              AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding Color, Converter={StaticResource HexBrush}}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" />
                                        <Border Margin="6,0,0,0" Padding="6,0" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                Visibility="{Binding CountText, Converter={StaticResource VisibleWhen}}">
                                            <TextBlock Text="{Binding CountText}" FontSize="11" />
                                        </Border>
                                        <Ellipse Width="7" Height="7" Margin="4,0,0,0" Fill="{StaticResource Attention}" VerticalAlignment="Center"
                                                 Visibility="{Binding HasAttention, Converter={StaticResource VisibleWhen}}" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource IconButton}" Content="+" ToolTip="Add group" AutomationProperties.Name="Add group" Command="{Binding AddGroupCommand}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CaptureBox" Text="{Binding QuickText, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"
                         AutomationProperties.Name="Quick add task" KeyDown="OnCaptureKeyDown"
                         ToolTip="Add a task. Optional: ! high, !! critical, @2h / @tomorrow defer, due:3d deadline. Ctrl+Alt+Space from anywhere." />
                <TextBlock Text="Add a task…  !! @2h due:tomorrow" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.5"
                           Visibility="{Binding QuickText, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                <Button Grid.Column="1" Content="Add" Margin="4,0,0,0" Command="{Binding CaptureCommand}" />
            </Grid>

            <TextBlock Grid.Row="3" x:Name="Status" Text="{Binding StatusMessage}" Margin="2,4,0,0" Style="{StaticResource Muted}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource VisibleWhen}}" />

            <ScrollViewer Grid.Row="4" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Focus: the single next thing to do -->
                    <Border Padding="12" CornerRadius="10" BorderThickness="0,0,0,0" Margin="0,0,0,8"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="DO THIS NOW" FontSize="11" FontWeight="SemiBold" Opacity="0.65" />
                            <ContentControl Content="{Binding Focus}" ContentTemplate="{StaticResource CardTemplate}" Margin="0,4,0,0" FontSize="15"
                                            Visibility="{Binding HasFocus, Converter={StaticResource VisibleWhen}}" />
                            <StackPanel Visibility="{Binding HasFocus, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" Margin="0,4,0,0">
                                <TextBlock Text="Nothing is due. Enjoy the calm ✨" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding NextUpText}" Style="{StaticResource Muted}" Visibility="{Binding NextUpText, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Expander IsExpanded="True" Margin="0,0,0,6">
                        <Expander.Header>
                            <TextBlock Style="{StaticResource SectionHeader}">
                                <Run Text="Do now" /> <Run Text="{Binding NowCount, Mode=OneWay}" Foreground="Gray" />
                            </TextBlock>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Now}" ItemTemplate="{StaticResource CardTemplate}" Margin="0,4,0,0" />
                    </Expander>

                    <Expander Margin="0,0,0,6">
                        <Expander.Header>
                            <TextBlock Style="{StaticResource SectionHeader}">
                                <Run Text="Waiting" /> <Run Text="{Binding WaitingCount, Mode=OneWay}" Foreground="Gray" />
                            </TextBlock>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Waiting}" ItemTemplate="{StaticResource CardTemplate}" Margin="0,4,0,0" />
                    </Expander>

                    <Expander Margin="0,0,0,6">
                        <Expander.Header>
                            <TextBlock Text="Workstreams" Style="{StaticResource SectionHeader}" />
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Workstreams}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type d:WorkstreamViewModel}">
                                    <Button Margin="0,0,0,6" HorizontalContentAlignment="Stretch" Padding="8,6"
                                            Command="{Binding DataContext.OpenWorkstreamReportCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                            ToolTip="Open full report">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,4"
                                                         Foreground="{Binding PriorityColor, Converter={StaticResource HexBrush}}" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <Expander Margin="0,0,0,6">
                        <Expander.Header>
                            <TextBlock Text="Recent notes" Style="{StaticResource SectionHeader}" />
                        </Expander.Header>
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding RecentNotes}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type d:NoteViewModel}">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource Muted}">
                                                <Run Text="{Binding ItemTitle, Mode=OneWay}" /> · <Run Text="{Binding Meta, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Full timeline in browser →" HorizontalAlignment="Left" Command="{Binding OpenReportCommand}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <!-- Focus timer -->
            <Border Grid.Row="5" Margin="0,8,0,0" Padding="10,6" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="🍅" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Pomodoro.TimeText}" FontSize="18" FontWeight="SemiBold" Margin="8,0" VerticalAlignment="Center"
                               AutomationProperties.Name="Focus timer" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="▶" ToolTip="Start focus" Command="{Binding StartFocusCommand}"
                                Visibility="{Binding Pomodoro.IsIdle, Converter={StaticResource VisibleWhen}}" />
                        <Button Style="{StaticResource IconButton}" Content="⏸" ToolTip="Pause" Command="{Binding PausePomodoroCommand}"
                                Visibility="{Binding Pomodoro.IsRunning, Converter={StaticResource VisibleWhen}}" />
                        <Button Style="{StaticResource IconButton}" Content="▶" ToolTip="Resume" Command="{Binding ResumePomodoroCommand}"
                                Visibility="{Binding Pomodoro.IsPaused, Converter={StaticResource VisibleWhen}}" />
                        <Button Style="{StaticResource IconButton}" Content="⏭" ToolTip="Skip" Command="{Binding SkipPomodoroCommand}"
                                Visibility="{Binding Pomodoro.IsIdle, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        <Button Style="{StaticResource IconButton}" Content="⟲" ToolTip="Reset" Command="{Binding ResetPomodoroCommand}"
                                Visibility="{Binding Pomodoro.IsIdle, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Pomodoro.Label}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Compact strip -->
        <StackPanel x:Name="CompactView" Margin="4,10" HorizontalAlignment="Center"
                    Visibility="{Binding IsCompact, Converter={StaticResource VisibleWhen}}">
            <Button Style="{StaticResource IconButton}" Content="⇤" ToolTip="Expand sidebar" AutomationProperties.Name="Expand" Command="{Binding ToggleCompactCommand}" Margin="0,0,0,10" />
            <Border CornerRadius="14" Padding="8,4" Background="{StaticResource Accent}" HorizontalAlignment="Center" ToolTip="Things to do now">
                <TextBlock Text="{Binding CompactSummary}" Foreground="White" FontWeight="Bold" FontSize="14" />
            </Border>
            <Ellipse Width="10" Height="10" Margin="0,8,0,0" Fill="{StaticResource Attention}" ToolTip="A reminder needs attention"
                     Visibility="{Binding HasAttention, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding Pomodoro.TimeText}" FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Center"
                       Visibility="{Binding Pomodoro.IsIdle, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
        </StackPanel>
    </Grid>
</Window>

