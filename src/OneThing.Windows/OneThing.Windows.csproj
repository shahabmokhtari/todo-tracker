<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon); WPF types stay the default names. -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>OneThing</AssemblyName>
    <!-- The icon Explorer, the taskbar and every window show; drawn by build/icons.py. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The name Windows shows (Task Manager, notifications); the file stays OneThing.exe so updates replace it. -->
    <Product>One Thing</Product>
    <AssemblyTitle>One Thing</AssemblyTitle>
    <RootNamespace>OneThing.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: Fluent ThemeMode is marked experimental but is the supported way to get Windows 11 styling + dark mode. -->
    <!-- WFO0003: a WinForms-app rule; this is a WPF app whose per-monitor DPI awareness belongs in app.manifest. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <ProjectReference Include="..\OneThing.Server\OneThing.Server.csproj" />
    <ProjectReference Include="..\OneThing.Desktop\OneThing.Desktop.csproj" />
    <!--
      The onething command (and its short name ot) ships in a cli folder next to the app, so AI apps can launch
      "onething mcp" without installing anything else. Not next to OneThing.exe: Windows file names ignore case, so
      onething.exe and onething.dll would replace the app's own files.
    -->
    <ProjectReference Include="..\OneThing.Cli\OneThing.Cli.csproj" ReferenceOutputAssembly="false" Private="false" OutputItemType="ShippedCli" />
  </ItemGroup>

  <Target Name="CopyCliToOutput" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_ShippedCliFile Include="%(ShippedCli.RootDir)%(ShippedCli.Directory)*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ShippedCliFile)" DestinationFolder="$(OutDir)cli" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishCliNextToApp" AfterTargets="Publish">
    <MSBuild Projects="..\OneThing.Cli\OneThing.Cli.csproj" Targets="Publish" Properties="PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)cli'))\" />
  </Target>
</Project>

